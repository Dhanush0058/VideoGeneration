# StudyFlow AI Environment Configurations

# Server Settings
PORT=8000
HOST=127.0.0.1

# Low Resource mode (Toggles heavy local model downloads)
# If true: Uses diagrams/PIL fallback if HuggingFace/local fails, and avoids local PyTorch image gen.
LOW_RESOURCE=true

# Storage paths
STORAGE_PATH=./storage

# --- LLM SERVICE SETTINGS ---
# Providers: GEMINI, GROQ, OPENAI, MOCK
LLM_PROVIDER=MOCK
# Model identifiers
# For GEMINI: gemini-1.5-flash
# For GROQ: llama-3.1-70b-versatile, gemma2-9b-it
# For OPENAI: gpt-4o-mini
MODEL_NAME=gemini-1.5-flash

# API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# --- TTS SERVICE SETTINGS ---
# Providers: EDGE_TTS, LOCAL_PYTTSX3
TTS_PROVIDER=EDGE_TTS
# Microsoft Edge TTS Voice list: en-US-GuyNeural, en-US-AriaNeural, en-GB-SoniaNeural, etc.
TTS_VOICE=en-US-GuyNeural

# --- IMAGE SERVICE SETTINGS ---
# Providers: HF_API, POLLINATIONS, DIAGRAM_FALLBACK
IMAGE_PROVIDER=DIAGRAM_FALLBACK
# Hugging Face image model (if HF_API selected):
# e.g., stabilityai/stable-diffusion-xl-base-1.0 or black-forest-labs/FLUX.1-schnell
IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# --- OPTIONAL VIDEO GENERATION ---
# Providers: NONE
VIDEO_PROVIDER=NONE
VIDEO_MODEL=
